# --- Database ---------------------------------------------------------------
# Connection string for the target PostgreSQL server.
DATABASE_URL=postgres://capture@127.0.0.1:5432/anime_platform

# --- AniList API (importer) -------------------------------------------------
ANILIST_ENDPOINT=https://graphql.anilist.co
ANILIST_ACCESS_TOKEN=
ANILIST_DELAY_MS=400
ANILIST_PER_PAGE=50

# --- API server -------------------------------------------------------------
NODE_ENV=development
PORT=3000

# --- JWT --------------------------------------------------------------------
# Generate strong values with: node scripts/generate-secrets.mjs
# (at least 32 chars each; 64 hex chars recommended)
JWT_ACCESS_SECRET=change-me-generate-with-scripts-generate-secrets
JWT_REFRESH_SECRET=change-me-generate-with-scripts-generate-secrets
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# --- CORS / proxy -----------------------------------------------------------
# Comma-separated origins, or * for all. 'true' | 'false' | hop count.
CORS_ORIGIN=*
TRUST_PROXY=false

# --- Rate limiting ----------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10

# --- Logging ----------------------------------------------------------------
LOG_LEVEL=info
# LOG_FILE=/var/log/anime-api.log

# --- Caching ----------------------------------------------------------------
# 0 disables response caching.
CACHE_TTL_MS=60000
CACHE_MAX_ENTRIES=500
