# --- Database ---------------------------------------------------------------
# Connection string for the target PostgreSQL server.
DATABASE_URL=postgres://capture@127.0.0.1:5432/anime_platform

# Password for the docker-compose PostgreSQL container (required by compose;
# generate one, e.g. `openssl rand -hex 16`).
POSTGRES_PASSWORD=

# --- AniList API (importer) -------------------------------------------------
ANILIST_ENDPOINT=https://graphql.anilist.co
ANILIST_ACCESS_TOKEN=
ANILIST_DELAY_MS=400
ANILIST_PER_PAGE=50

# --- API server -------------------------------------------------------------
NODE_ENV=development
PORT=3000

# --- JWT --------------------------------------------------------------------
# Generate strong values with: node scripts/generate-secrets.mjs
# (at least 32 chars each; 64 hex chars recommended).
# Keep these EMPTY here — the app fails fast at startup if they are unset or
# too short, so a copy-paste deploy can never ship with known secrets.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# --- CORS / proxy -----------------------------------------------------------
# Comma-separated origins for browser clients. '*' is allowed in development
# ONLY — in production an explicit allowlist is required (the app refuses to
# start with '*' because credentials are enabled).
CORS_ORIGIN=*
# 'true' | 'false' | hop count. Behind a reverse proxy / load balancer set the
# hop count (e.g. 1) so rate limiting keys on the real client IP.
TRUST_PROXY=false

# --- Rate limiting ----------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10

# --- Logging ----------------------------------------------------------------
LOG_LEVEL=info
# LOG_FILE=/var/log/anime-api.log

# --- Caching ----------------------------------------------------------------
# 0 disables response caching.
CACHE_TTL_MS=60000
CACHE_MAX_ENTRIES=500

# --- Anivexa streaming provider ---------------------------------------------
# Self-hosted Anivexa API (episode streams). Leave unset to disable streaming;
# the watch endpoints then return 503 STREAMING_NOT_CONFIGURED.
# ANIVEXA_API_URL=http://192.168.0.193:4000
# Provider failover order (comma-separated). Unknown providers are skipped.
# ANIVEXA_PROVIDERS=reanime,anikoto,animegg,anineko,anidbapp,kaa
# Stream/episode cache TTL (default 30 min; 30-60 recommended)
# ANIVEXA_CACHE_TTL_MS=1800000
# ANIVEXA_TIMEOUT_MS=15000
# Max watch providers probed in parallel per episode (default 3)
# ANIVEXA_MAX_PARALLEL=3
# Episodes warmed per prefetch call (default 3)
# ANIVEXA_PREFETCH_EPISODES=3

# --- MyAnimeList sync --------------------------------------------------------
# Public MAL app credentials: https://myanimelist.net/apiconfig
# The OAuth redirect URI MUST be registered as {BACKEND_URL}/api/mal/callback
# (MAL only allows http://localhost callbacks without a public app).
MAL_CLIENT_ID=your_mal_client_id
MAL_CLIENT_SECRET=your_mal_client_secret
# 32-byte key (raw/base64/hex) used to encrypt MAL tokens at rest. Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MAL_TOKEN_ENCRYPTION_KEY=
# Where the frontend is served — MAL OAuth redirects back here after linking.
FRONTEND_URL=http://localhost:5173
# Optional: separate secret for signed cookies (defaults to JWT_ACCESS_SECRET).
# COOKIE_SECRET=
# MAL_API_TIMEOUT_MS=10000
