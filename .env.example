# --- Database ---------------------------------------------------------------
# Connection string for the target PostgreSQL server. The importer and the
# migration runner both read this.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/anime_platform

# --- AniList API ------------------------------------------------------------
# Endpoint of the AniList GraphQL API.
ANILIST_ENDPOINT=https://graphql.anilist.co

# Optional personal access token (https://anilist.co/settings/developer).
# Required only for higher rate limits; public queries work without it.
ANILIST_ACCESS_TOKEN=

# --- Importer defaults (all overridable via CLI flags) ----------------------
ANILIST_DELAY_MS=400
ANILIST_PER_PAGE=50
