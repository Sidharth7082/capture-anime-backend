# CaptureOrDie importer configuration. Copy to .env and adjust.

# --- Jikan API (self-hosted) ------------------------------------------------
# Base URL of the local Jikan instance (v4 REST API).
JIKAN_API_URL=http://192.168.0.193:8081
JIKAN_TIMEOUT_MS=15000
JIKAN_RETRY_COUNT=3
# Polite delay between page requests (0 to disable).
JIKAN_PAGE_DELAY_MS=150

# --- PostgreSQL --------------------------------------------------------------
# Same database the CaptureOrDie API uses.
DATABASE_URL=postgres://capture:password@localhost:5432/capture_anime
PG_POOL_MAX=5

# --- Typesense (optional search index) ---------------------------------------
# Leave disabled until the search step of the importer is implemented.
TYPESENSE_ENABLED=false
TYPESENSE_URL=http://localhost:8108
TYPESENSE_API_KEY=your_typesense_api_key
TYPESENSE_COLLECTION=anime

# --- Scheduler ---------------------------------------------------------------
# Run a full import immediately at startup, then on an interval.
RUN_ON_START=true
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_MS=3600000

# --- Logging -----------------------------------------------------------------
LOG_LEVEL=info
# Structured logs: "json" (one object per line, jq-friendly) or "pretty".
# Defaults: json in production, pretty elsewhere.
LOG_FORMAT=json

# --- Health endpoint ---------------------------------------------------------
# GET /health reports the last import, the current job and the next run.
HEALTH_ENABLED=true
HEALTH_PORT=9090
ENRICH_BATCH_SIZE=10
ENRICH_STALE_DAYS=0

# --- AniList (canonical source) ----------------------------------------------
# Enable the AniList sync in the daemon scheduler. The CLI runs it explicitly
# with `npm run import:anilist` regardless of this flag.
ANILIST_ENABLED=false
ANILIST_ENDPOINT=https://graphql.anilist.co
# Recommended for a much higher API quota (https://anilist.co/settings/developer).
ANILIST_ACCESS_TOKEN=
ANILIST_PER_PAGE=50
# Polite spacing between GraphQL requests (AniList throttles ~90/min unauth).
ANILIST_MIN_INTERVAL_MS=450
