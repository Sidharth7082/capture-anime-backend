{
  "name": "capture-anime-importer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Standalone anime importer: pulls data from the local Jikan API and writes it for the CaptureOrDie platform (PostgreSQL + optional Typesense index).",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "import:anime": "tsx src/run-import.ts",
    "import:enrich": "tsx src/run-import.ts --enrich",
    "verify-catalog": "tsx src/verify-catalog.ts",
    "import:anilist": "tsx src/run-import.ts --anilist",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test \"src/**/*.test.ts\" \"src/*.test.ts\""
  },
  "dependencies": {
    "axios": "^1.7.9",
    "dotenv": "^16.4.7",
    "pg": "^8.13.1",
    "typesense": "^1.7.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
